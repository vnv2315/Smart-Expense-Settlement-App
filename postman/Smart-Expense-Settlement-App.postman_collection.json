{
  "info": {
    "name": "Smart Expense Settlement App",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1" },
    { "key": "token", "value": "" },
    { "key": "groupId", "value": "" },
    { "key": "memberUserId", "value": "" },
    { "key": "payerUserId", "value": "" },
    { "key": "debtId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Sign up",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Asha\",\n  \"email\": \"asha@example.com\",\n  \"password\": \"password123\"\n}" },
            "url": "{{baseUrl}}/auth/signup"
          }
        },
        {
          "name": "Log in",
          "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('token', pm.response.json().token);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"asha@example.com\",\n  \"password\": \"password123\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "Groups",
      "item": [
        {
          "name": "Create group",
          "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('groupId', pm.response.json().group._id);"] } }],
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Goa Trip\"\n}" }, "url": "{{baseUrl}}/groups" }
        },
        { "name": "List my groups", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/groups" } },
        { "name": "Add member", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"userId\": \"{{memberUserId}}\"\n}" }, "url": "{{baseUrl}}/groups/{{groupId}}/members" } },
        { "name": "Remove member", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/groups/{{groupId}}/members/{{memberUserId}}" } }
      ]
    },
    {
      "name": "Expenses and settlement",
      "item": [
        { "name": "Add equal-split expense", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"description\": \"Dinner\",\n  \"amountInPaise\": 10000,\n  \"paidBy\": \"{{payerUserId}}\"\n}" }, "url": "{{baseUrl}}/groups/{{groupId}}/expenses" } },
        { "name": "Get settlement plan", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/groups/{{groupId}}/settlement" } }
      ]
    },
    {
      "name": "Debts",
      "item": [
        { "name": "Create debt", "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('debtId', pm.response.json().debt._id);"] } }], "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"from\": \"{{memberUserId}}\",\n  \"to\": \"{{payerUserId}}\",\n  \"amountInPaise\": 2500\n}" }, "url": "{{baseUrl}}/groups/{{groupId}}/debts" } },
        { "name": "Mark debt settled", "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/groups/{{groupId}}/debts/{{debtId}}/settle" } }
      ]
    }
  ]
}
